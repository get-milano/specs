{
  "milano": "1.0.0",
  "name": "examples",
  "version": "1.0.0",
  "components": {
    "Banner": {
      "properties": {
        "backgroundImageUrl": "string"
      },
      "children": true
    },
    "Column": {
      "children": true
    },
    "Text": {
      "properties": {
        "text": "string",
        "visible": "bool?"
      }
    },
    "Button": {
      "properties": {
        "label": "string",
        "enabled": "bool"
      },
      "events": {
        "tap": null
      }
    },
    "TextField": {
      "properties": {
        "label": "string",
        "value": "string"
      },
      "events": {
        "change": "string"
      }
    },
    "NumberField": {
      "properties": {
        "label": "string",
        "value": "double"
      },
      "events": {
        "change": "double"
      }
    },
    "Checkbox": {
      "properties": {
        "label": "string",
        "checked": "bool"
      },
      "events": {
        "change": "bool"
      }
    },
    "Badge": {
      "properties": {
        "label": "string",
        "tone": {
          "enum": [
            "info",
            "warning",
            "danger"
          ]
        }
      },
      "events": {
        "select": {
          "enum": [
            "info",
            "warning",
            "danger"
          ]
        }
      }
    },
    "Meta": {
      "properties": {
        "key": "string"
      },
      "strict": true
    }
  },
  "actions": {
    "openUrl": {
      "parameters": {
        "url": "string"
      }
    },
    "submitContact": {
      "parameters": {
        "name": "string",
        "surname": "string",
        "email": "string",
        "phone": "string?"
      }
    }
  }
}

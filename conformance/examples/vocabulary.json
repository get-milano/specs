{
  "milano": "2.1.0",
  "name": "examples",
  "version": "1.1.0",
  "components": {
    "Banner": {
      "properties": {
        "backgroundImageUrl": "string"
      },
      "children": true
    },
    "Column": {
      "children": true
    },
    "Text": {
      "properties": {
        "text": "string",
        "visible": "bool?"
      }
    },
    "Button": {
      "properties": {
        "label": "string",
        "enabled": "bool"
      },
      "events": {
        "tap": null
      }
    },
    "TextField": {
      "properties": {
        "label": "string",
        "value": "string"
      },
      "events": {
        "change": "string"
      }
    },
    "NumberField": {
      "properties": {
        "label": "string",
        "value": "double"
      },
      "events": {
        "change": "double"
      }
    },
    "Checkbox": {
      "properties": {
        "label": "string",
        "checked": "bool"
      },
      "events": {
        "change": "bool"
      }
    },
    "Badge": {
      "properties": {
        "label": "string",
        "tone": {
          "enum": [
            "info",
            "warning",
            "danger"
          ]
        }
      },
      "events": {
        "select": {
          "enum": [
            "info",
            "warning",
            "danger"
          ]
        }
      }
    },
    "Meta": {
      "properties": {
        "key": "string"
      },
      "strict": true
    },
    "Row": {
      "properties": {
        "spacing": "int?"
      },
      "children": true
    },
    "Card": {
      "properties": {
        "cornerRadius": "int?",
        "accessibilityLabel": "string?"
      },
      "children": true,
      "events": {
        "tap": null
      }
    },
    "Icon": {
      "properties": {
        "name": {
          "enum": [
            "person",
            "list",
            "search",
            "edit",
            "settings",
            "help"
          ]
        }
      }
    }
  },
  "actions": {
    "openUrl": {
      "parameters": {
        "url": "string"
      }
    },
    "submitContact": {
      "parameters": {
        "name": "string",
        "surname": "string",
        "email": "string",
        "phone": "string?"
      },
      "failure": {
        "enum": [
          "invalid",
          "unavailable"
        ]
      }
    },
    "navigate": {
      "parameters": {
        "screen": {
          "enum": [
            "profile",
            "catalog",
            "settings",
            "help"
          ]
        }
      }
    },
    "logEvent": {
      "parameters": {
        "event": "string",
        "surface": "string",
        "position": "int"
      }
    }
  },
  "functions": {
    "formatMoney": {
      "arguments": [
        "int",
        "string"
      ],
      "returns": "string"
    },
    "shout": {
      "arguments": [
        "string"
      ],
      "returns": "string"
    },
    "parseInt": {
      "arguments": [
        "string"
      ],
      "returns": "int?"
    },
    "scale": {
      "arguments": [
        "double",
        "int"
      ],
      "returns": "double"
    },
    "tone": {
      "arguments": [
        {
          "enum": [
            "info",
            "warning",
            "danger"
          ]
        }
      ],
      "returns": {
        "enum": [
          "info",
          "warning",
          "danger"
        ]
      }
    },
    "round": {
      "arguments": [
        "double",
        "int"
      ],
      "returns": "string"
    }
  }
}

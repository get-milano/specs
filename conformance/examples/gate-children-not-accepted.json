{
  "name": "gate-children-not-accepted",
  "description": "children are allowed only on component types the vocabulary declares as accepting them",
  "document": {
    "version": "2.0.0",
    "root": {
      "type": "Text",
      "id": "t",
      "properties": {
        "text": "x"
      },
      "children": [
        {
          "type": "Text",
          "properties": {
            "text": "nested"
          }
        }
      ]
    }
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "children",
      "node": "t",
      "expected": "no children",
      "found": "children"
    }
  }
}

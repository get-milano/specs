{
  "name": "gate-result-outside-onsuccess",
  "description": "result is scoped to onSuccess: referencing it in an action's own parameters is a SchemaViolation",
  "document": {
    "version": "2.0.0",
    "root": {
      "type": "Button",
      "id": "b",
      "properties": {
        "label": "Go",
        "enabled": true
      },
      "on": {
        "tap": [
          {
            "action": "notify",
            "message": {
              "$expr": "result"
            }
          }
        ]
      }
    }
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "expression",
      "node": "b"
    }
  },
  "config": {
    "actions": {
      "declare": {
        "notify": {
          "parameters": {
            "message": "string"
          },
          "result": "string"
        }
      }
    }
  }
}

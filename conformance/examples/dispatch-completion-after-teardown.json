{
  "name": "dispatch-completion-after-teardown",
  "description": "A completion arriving after the view is torn down drops its follow-ups and reports",
  "document": {
    "version": "1.0.0",
    "state": {
      "done": "bool"
    },
    "root": {
      "type": "Button",
      "id": "b",
      "properties": {
        "label": "Go",
        "enabled": true
      },
      "on": {
        "tap": [
          {
            "action": "ping",
            "onSuccess": [
              {
                "action": "$set",
                "key": "done",
                "value": true
              }
            ]
          }
        ]
      }
    }
  },
  "state": {
    "done": false
  },
  "steps": [
    {
      "event": {
        "node": "b",
        "name": "tap"
      }
    },
    {
      "teardown": true
    },
    {
      "complete": {
        "dispatch": 0,
        "outcome": "success"
      }
    }
  ],
  "expect": {
    "dispatched": [
      {
        "action": "ping",
        "parameters": {}
      }
    ],
    "occurrences": [
      {
        "kind": "completionAfterTeardown",
        "name": "ping"
      }
    ]
  },
  "config": {
    "actions": {
      "declare": {
        "ping": {}
      }
    }
  }
}

{
  "name": "switch-refuses-an-empty-default",
  "description": "A $switch `default` is a non-empty node list, like every branch",
  "document": {
    "version": "2.1.0",
    "root": {
      "type": "Column",
      "id": "c",
      "children": [
        {
          "type": "$switch",
          "subject": {
            "$expr": "state.status"
          },
          "cases": {
            "ok": [
              {
                "type": "Text",
                "properties": {
                  "text": "x"
                }
              }
            ],
            "late": [
              {
                "type": "Text",
                "properties": {
                  "text": "x"
                }
              }
            ]
          },
          "default": []
        }
      ]
    },
    "state": {
      "status": {
        "enum": [
          "ok",
          "late"
        ]
      }
    }
  },
  "state": {
    "status": "ok"
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "switch",
      "node": "root/children[0]",
      "expected": "default branch",
      "found": "empty"
    }
  }
}

{
  "name": "switch-undeclared-key",
  "description": "A $switch carries only the keys the construct declares",
  "document": {
    "version": "2.1.0",
    "root": {
      "type": "Column",
      "id": "c",
      "children": [
        {
          "type": "$switch",
          "subject": {
            "$expr": "state.status"
          },
          "cases": {
            "ok": [
              {
                "type": "Text",
                "properties": {
                  "text": "x"
                }
              }
            ],
            "late": [
              {
                "type": "Text",
                "properties": {
                  "text": "x"
                }
              }
            ]
          },
          "items": {
            "$expr": "state.status"
          }
        }
      ]
    },
    "state": {
      "status": {
        "enum": [
          "ok",
          "late"
        ]
      }
    }
  },
  "state": {
    "status": "ok"
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "switch",
      "node": "root/children[0]",
      "expected": "declared key",
      "found": "items"
    }
  }
}

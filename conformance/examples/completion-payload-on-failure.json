{
  "name": "completion-payload-on-failure",
  "description": "A failure completion for an action declaring no failure type never carries data: any value on it is an invalid completion and onFailure does not run",
  "document": {
    "version": "2.0.0",
    "state": {
      "code": "string"
    },
    "root": {
      "type": "Button",
      "id": "b",
      "properties": {
        "label": "Go",
        "enabled": true
      },
      "on": {
        "tap": [
          {
            "action": "fetchCode",
            "onFailure": [
              {
                "action": "$set",
                "key": "code",
                "value": "failed"
              }
            ]
          }
        ]
      }
    }
  },
  "state": {
    "code": "start"
  },
  "steps": [
    {
      "event": {
        "node": "b",
        "name": "tap"
      }
    },
    {
      "complete": {
        "dispatch": 0,
        "outcome": "failure",
        "payload": "x"
      }
    }
  ],
  "expect": {
    "state": {
      "code": "start"
    },
    "dispatched": [
      {
        "action": "fetchCode",
        "parameters": {}
      }
    ],
    "occurrences": [
      {
        "kind": "invalidCompletion",
        "name": "fetchCode",
        "expected": "no payload",
        "found": "string"
      }
    ]
  },
  "config": {
    "actions": {
      "declare": {
        "fetchCode": {
          "result": "string"
        }
      }
    }
  }
}

{
  "name": "watch-not-triggered-when-unchanged",
  "description": "A mutation the store accepts unchanged triggers no watch",
  "document": {
    "version": "2.1.0",
    "state": {
      "a": "int",
      "b": "int",
      "c": "int"
    },
    "root": {
      "type": "Column",
      "id": "c",
      "children": [
        {
          "type": "Text",
          "id": "a",
          "properties": {
            "text": {
              "$expr": "$str(state.a)"
            }
          }
        },
        {
          "type": "Text",
          "id": "b",
          "properties": {
            "text": {
              "$expr": "$str(state.b)"
            }
          }
        },
        {
          "type": "Button",
          "id": "go",
          "properties": {
            "label": "Go",
            "enabled": true
          },
          "on": {
            "tap": [
              {
                "action": "$set",
                "key": "a",
                "value": 5
              }
            ]
          }
        }
      ]
    },
    "watch": {
      "a": [
        {
          "action": "$set",
          "key": "b",
          "value": {
            "$expr": "state.b + 1"
          }
        }
      ]
    }
  },
  "state": {
    "a": 5,
    "b": 0,
    "c": 0
  },
  "steps": [
    {
      "event": {
        "node": "go",
        "name": "tap"
      }
    }
  ],
  "expect": {
    "state": {
      "a": 5,
      "b": 0,
      "c": 0
    },
    "occurrences": []
  }
}

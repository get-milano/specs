{
  "name": "dispatch-unbound-event",
  "description": "A declared event emitted with no binding is dropped and reported; nothing dispatches",
  "document": {
    "version": "1.0.0",
    "root": {
      "type": "Button",
      "id": "b",
      "properties": {
        "label": "Go",
        "enabled": true
      }
    }
  },
  "steps": [
    {
      "event": {
        "node": "b",
        "name": "tap"
      }
    }
  ],
  "expect": {
    "dispatched": [],
    "occurrences": [
      {
        "kind": "droppedEvent",
        "node": "b"
      }
    ]
  }
}

{
  "name": "switch-needs-2-1",
  "description": "A 2.0 document may not carry the construct",
  "document": {
    "version": "2.0.0",
    "state": {
      "status": {
        "enum": [
          "ok",
          "late",
          "failed"
        ]
      },
      "labels": {
        "record": {
          "ok": "string",
          "late": "string",
          "failed": "string"
        }
      }
    },
    "root": {
      "type": "Column",
      "id": "c",
      "children": [
        {
          "type": "$switch",
          "subject": {
            "$expr": "state.status"
          },
          "cases": {
            "ok": [
              {
                "type": "Text",
                "properties": {
                  "text": "Ready"
                }
              }
            ],
            "late": [
              {
                "type": "Text",
                "properties": {
                  "text": "Running late"
                }
              }
            ],
            "failed": [
              {
                "type": "Text",
                "properties": {
                  "text": "Failed"
                }
              }
            ]
          }
        }
      ]
    }
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "contract-feature",
      "node": "root/children[0]",
      "expected": "2.1",
      "found": "$switch"
    }
  }
}

{
  "name": "gate-watch-undeclared-key",
  "description": "A watch entry naming a key the document does not declare is the watch rule, with no node",
  "document": {
    "version": "2.1.0",
    "state": {
      "a": "int",
      "b": "int",
      "c": "int"
    },
    "root": {
      "type": "Column",
      "id": "c",
      "children": [
        {
          "type": "Text",
          "id": "a",
          "properties": {
            "text": {
              "$expr": "$str(state.a)"
            }
          }
        },
        {
          "type": "Text",
          "id": "b",
          "properties": {
            "text": {
              "$expr": "$str(state.b)"
            }
          }
        },
        {
          "type": "Button",
          "id": "go",
          "properties": {
            "label": "Go",
            "enabled": true
          },
          "on": {
            "tap": []
          }
        }
      ]
    },
    "watch": {
      "missing": []
    }
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "watch",
      "expected": "declared state key",
      "found": "missing"
    }
  }
}

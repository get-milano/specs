{
  "name": "string-replace-needs-2-1",
  "description": "A 2.0 document calling replace fails with contract-feature",
  "document": {
    "version": "2.0.0",
    "root": {
      "type": "Text",
      "id": "r",
      "properties": {
        "text": {
          "$expr": "$replace('hello', 'l', 'L')"
        }
      }
    }
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "contract-feature",
      "node": "r",
      "expected": "2.1",
      "found": "$replace"
    }
  }
}

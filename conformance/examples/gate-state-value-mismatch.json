{
  "name": "gate-state-value-mismatch",
  "description": "A provider value not matching the state declaration fails with SchemaViolation",
  "document": {
    "version": "0.1.0",
    "state": {
      "consent": "bool"
    },
    "root": {
      "type": "Checkbox",
      "id": "c",
      "properties": {
        "label": "Agree",
        "checked": {
          "$expr": "state.consent"
        }
      }
    }
  },
  "state": {
    "consent": "yes"
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "state-declaration",
      "expected": "bool",
      "found": "string"
    }
  }
}

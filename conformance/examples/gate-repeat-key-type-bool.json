{
  "name": "gate-repeat-key-type-bool",
  "description": "key must type to a string or an int: a bool is rejected",
  "document": {
    "version": "2.1.0",
    "state": {
      "rows": {
        "array": {
          "record": {
            "flag": "bool",
            "name": "string"
          }
        }
      }
    },
    "root": {
      "type": "Column",
      "id": "list",
      "children": [
        {
          "type": "$repeat",
          "id": "each",
          "items": {
            "$expr": "state.rows"
          },
          "as": "row",
          "key": {
            "$expr": "row.flag"
          },
          "children": [
            {
              "type": "Text",
              "id": "name",
              "properties": {
                "text": {
                  "$expr": "row.name"
                }
              }
            }
          ]
        }
      ]
    }
  },
  "state": {
    "rows": [
      {
        "flag": true,
        "name": "x"
      }
    ]
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "repeat",
      "node": "each",
      "expected": "key type",
      "found": "bool"
    }
  }
}

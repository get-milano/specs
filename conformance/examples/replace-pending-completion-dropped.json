{
  "name": "replace-pending-completion-dropped",
  "description": "A completion of a dispatch made before the replacement is dropped and reported; the dispatch counts as completed, so a second completion is a duplicate",
  "document": {
    "version": "2.1.0",
    "state": {
      "n": "int"
    },
    "root": {
      "type": "Column",
      "id": "c",
      "children": [
        {
          "type": "Text",
          "id": "r",
          "properties": {
            "text": {
              "$expr": "$str(state.n)"
            }
          }
        },
        {
          "type": "Button",
          "id": "go",
          "properties": {
            "label": "Go",
            "enabled": true
          },
          "on": {
            "tap": [
              {
                "action": "openUrl",
                "url": "u",
                "onSuccess": [
                  {
                    "action": "$set",
                    "key": "n",
                    "value": 1
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "state": {
    "n": 0
  },
  "steps": [
    {
      "event": {
        "node": "go",
        "name": "tap"
      }
    },
    {
      "replace": {
        "document": {
          "version": "2.1.0",
          "state": {
            "n": "int"
          },
          "root": {
            "type": "Column",
            "id": "c",
            "children": [
              {
                "type": "Text",
                "id": "r",
                "properties": {
                  "text": {
                    "$expr": "$str(state.n)"
                  }
                }
              },
              {
                "type": "Button",
                "id": "go",
                "properties": {
                  "label": "Go",
                  "enabled": true
                },
                "on": {
                  "tap": [
                    {
                      "action": "$set",
                      "key": "n",
                      "value": {
                        "$expr": "state.n + 5"
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "complete": {
        "dispatch": 0,
        "outcome": "success"
      }
    },
    {
      "complete": {
        "dispatch": 0,
        "outcome": "success"
      }
    }
  ],
  "expect": {
    "state": {
      "n": 0
    },
    "dispatched": [
      {
        "action": "openUrl",
        "parameters": {
          "url": "u"
        },
        "dispatch": 0
      }
    ],
    "occurrences": [
      {
        "kind": "completionAfterReplace",
        "name": "openUrl"
      },
      {
        "kind": "duplicateCompletion",
        "name": "openUrl"
      }
    ]
  }
}

{
  "name": "gate-expr-nonascii-digit",
  "description": "The grammar's digits are ASCII: an Arabic-Indic digit fails to tokenize and is a SchemaViolation",
  "document": {
    "version": "2.0.0",
    "root": {
      "type": "Text",
      "id": "t",
      "properties": {
        "text": {
          "$expr": "$str(\u0665)"
        }
      }
    }
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "expression",
      "node": "t",
      "expected": "string"
    }
  }
}

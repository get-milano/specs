{
  "name": "gate-limit-expression-length",
  "description": "An expression longer than maxExpressionLength is a LimitExceeded at the gate; one at the limit passes (concat pads to exactly 1025 characters)",
  "document": {
    "version": "1.0.0",
    "root": {
      "type": "Text",
      "id": "t",
      "properties": {
        "text": {
          "$expr": "concat('', 'y')"
        }
      }
    }
  },
  "expect": {
    "error": {
      "type": "LimitExceeded",
      "limit": "maxExpressionLength",
      "value": 1024,
      "actual": 1025
    }
  }
}

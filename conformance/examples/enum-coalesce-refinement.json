{
  "name": "enum-coalesce-refinement",
  "description": "The expected enum type propagates through ?? and if branches, so member literals refine instead of reading as plain strings",
  "document": {
    "version": "1.0.0",
    "state": {
      "maybe": {
        "enum": [
          "info",
          "warning",
          "danger"
        ],
        "optional": true
      }
    },
    "root": {
      "type": "Badge",
      "id": "b",
      "properties": {
        "label": "Sev",
        "tone": {
          "$expr": "state.maybe ?? 'info'"
        }
      }
    }
  },
  "state": {
    "maybe": null
  },
  "expect": {
    "view": {
      "type": "Badge",
      "reference": "b",
      "properties": {
        "label": "Sev",
        "tone": "info"
      }
    }
  }
}

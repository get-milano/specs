{
  "name": "conditional-condition-must-be-bool",
  "description": "A condition of another type is an encoding violation",
  "document": {
    "version": "2.1.0",
    "root": {
      "type": "Column",
      "id": "c",
      "children": [
        {
          "type": "$if",
          "condition": {
            "$expr": "'x'"
          },
          "then": [
            {
              "type": "Text",
              "properties": {
                "text": "a"
              }
            }
          ]
        }
      ]
    }
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "conditional",
      "node": "root/children[0]",
      "expected": "bool condition",
      "found": "string"
    }
  }
}

{
  "name": "gate-order-id-before-expression",
  "description": "The vocabulary walk is one pass in document order: a duplicate id at a node's envelope wins over an ill-typed expression inside the same node",
  "document": {
    "version": "1.0.0",
    "root": {
      "type": "Column",
      "id": "dup",
      "children": [
        {
          "type": "Text",
          "properties": {
            "text": "clean"
          }
        },
        {
          "type": "Text",
          "id": "dup",
          "properties": {
            "text": {
              "$expr": "1 + 1"
            }
          }
        }
      ]
    }
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "id-uniqueness",
      "found": "dup"
    }
  }
}

{
  "name": "watch-rejected-mutation-ends-watch-only",
  "description": "A rejected mutation inside a watch list ends the watch list only; the list that triggered it continues",
  "document": {
    "version": "2.1.0",
    "state": {
      "a": "int",
      "b": "int",
      "c": "int",
      "s": "string"
    },
    "root": {
      "type": "Column",
      "id": "c",
      "children": [
        {
          "type": "Text",
          "id": "a",
          "properties": {
            "text": {
              "$expr": "$str(state.a)"
            }
          }
        },
        {
          "type": "Text",
          "id": "b",
          "properties": {
            "text": {
              "$expr": "$str(state.b)"
            }
          }
        },
        {
          "type": "Button",
          "id": "go",
          "properties": {
            "label": "Go",
            "enabled": true
          },
          "on": {
            "tap": [
              {
                "action": "$set",
                "key": "a",
                "value": 1
              },
              {
                "action": "$set",
                "key": "c",
                "value": 4
              }
            ]
          }
        }
      ]
    },
    "watch": {
      "a": [
        {
          "action": "$set",
          "key": "s",
          "value": "toolong"
        },
        {
          "action": "$set",
          "key": "b",
          "value": 9
        }
      ]
    }
  },
  "state": {
    "a": 0,
    "b": 0,
    "c": 0,
    "s": ""
  },
  "config": {
    "limits": {
      "maxValueSize": 3
    }
  },
  "steps": [
    {
      "event": {
        "node": "go",
        "name": "tap"
      }
    }
  ],
  "expect": {
    "state": {
      "a": 1,
      "b": 0,
      "c": 4,
      "s": ""
    },
    "occurrences": [
      {
        "kind": "rejectedMutation",
        "name": "s",
        "expected": "maxValueSize",
        "found": "7"
      }
    ]
  }
}

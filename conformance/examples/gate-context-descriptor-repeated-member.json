  "documentText": "{\"version\": \"2.0.0\", \"context\": {\"x\": {\"enum\": [\"a\", \"a\"]}}, \"root\": {\"type\": \"Text\", \"id\": \"r\", \"properties\": {\"text\": \"x\"}}}",
  "context": {
    "x": "a"
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",

{
  "name": "gate-array-remove-at-not-int",
  "description": "The index is an int position: a string literal does not fit",
  "document": {
    "version": "2.1.0",
    "state": {
      "items": {
        "array": "string"
      },
      "n": "int"
    },
    "root": {
      "type": "Column",
      "id": "c",
      "children": [
        {
          "type": "Text",
          "id": "count",
          "properties": {
            "text": {
              "$expr": "$str($length(state.items))"
            }
          }
        },
        {
          "type": "Button",
          "id": "add",
          "properties": {
            "label": "Add",
            "enabled": true
          },
          "on": {
            "tap": [
              {
                "action": "$remove",
                "key": "items",
                "at": "first"
              }
            ]
          }
        }
      ]
    }
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "action-encoding",
      "node": "add",
      "expected": "int",
      "found": "string"
    }
  }
}

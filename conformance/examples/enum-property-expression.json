{
  "name": "enum-property-expression",
  "description": "An expression of the same enum type is accepted in an enum position and resolves to the member string",
  "document": {
    "version": "1.0.0",
    "state": {
      "tone": {
        "enum": [
          "info",
          "warning",
          "danger"
        ]
      }
    },
    "root": {
      "type": "Badge",
      "id": "b",
      "properties": {
        "label": "Sev",
        "tone": {
          "$expr": "state.tone"
        }
      }
    }
  },
  "state": {
    "tone": "danger"
  },
  "expect": {
    "view": {
      "type": "Badge",
      "reference": "b",
      "properties": {
        "label": "Sev",
        "tone": "danger"
      }
    }
  }
}

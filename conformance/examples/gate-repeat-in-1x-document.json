{
  "name": "gate-repeat-in-1x-document",
  "description": "A $repeat in a document declaring contract 1.x is the construct violation, as any $ type is there",
  "document": {
    "version": "1.0.0",
    "state": {
      "rows": {
        "array": {
          "record": {
            "name": "string",
            "url": "string"
          }
        }
      }
    },
    "root": {
      "type": "Column",
      "id": "list",
      "children": [
        {
          "type": "$repeat",
          "id": "each",
          "items": {
            "$expr": "state.rows"
          },
          "as": "row",
          "children": [
            {
              "type": "Text",
              "id": "name",
              "properties": {
                "text": {
                  "$expr": "row.name"
                }
              }
            }
          ]
        }
      ]
    }
  },
  "state": {
    "rows": [
      {
        "name": "Alpha",
        "url": "https://example.com/a"
      },
      {
        "name": "Beta",
        "url": "https://example.com/b"
      }
    ]
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "construct",
      "node": "each",
      "expected": "component type",
      "found": "$repeat"
    }
  }
}

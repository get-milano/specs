{
  "name": "gate-failure-type-mismatch",
  "description": "failure has exactly the declared type: an int payload does not fit a string state key",
  "document": {
    "version": "2.1.0",
    "state": {
      "label": "string"
    },
    "root": {
      "type": "Button",
      "id": "b",
      "properties": {
        "label": "Go",
        "enabled": true
      },
      "on": {
        "tap": [
          {
            "action": "fetchCode",
            "onFailure": [
              {
                "action": "$set",
                "key": "label",
                "value": {
                  "$expr": "failure"
                }
              }
            ]
          }
        ]
      }
    }
  },
  "state": {
    "label": ""
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "expression",
      "node": "b",
      "expected": "string"
    }
  },
  "config": {
    "actions": {
      "declare": {
        "fetchCode": {
          "failure": "int"
        }
      }
    }
  }
}

{
  "name": "completion-failure-enum-nonmember",
  "description": "A failure value outside the declared enum's members is an invalid completion",
  "document": {
    "version": "2.1.0",
    "state": {
      "message": "string"
    },
    "root": {
      "type": "Button",
      "id": "b",
      "properties": {
        "label": "Go",
        "enabled": true
      },
      "on": {
        "tap": [
          {
            "action": "fetchCode",
            "onFailure": [
              {
                "action": "$set",
                "key": "message",
                "value": {
                  "$expr": "failure"
                }
              }
            ]
          }
        ]
      }
    }
  },
  "state": {
    "message": "start"
  },
  "steps": [
    {
      "event": {
        "node": "b",
        "name": "tap"
      }
    },
    {
      "complete": {
        "dispatch": 0,
        "outcome": "failure",
        "payload": "teapot"
      }
    }
  ],
  "expect": {
    "state": {
      "message": "start"
    },
    "dispatched": [
      {
        "action": "fetchCode",
        "parameters": {},
        "dispatch": 0
      }
    ],
    "occurrences": [
      {
        "kind": "invalidCompletion",
        "name": "fetchCode",
        "expected": "enum",
        "found": "string"
      }
    ]
  },
  "config": {
    "actions": {
      "declare": {
        "fetchCode": {
          "failure": {
            "enum": [
              "limit",
              "offline"
            ]
          }
        }
      }
    }
  }
}

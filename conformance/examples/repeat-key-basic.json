{
  "name": "repeat-key-basic",
  "description": "A keyed repeat references each instance by the key's rendering instead of the element index; row_index still counts positions",
  "document": {
    "version": "2.1.0",
    "state": {
      "rows": {
        "array": {
          "record": {
            "id": "string",
            "name": "string",
            "url": "string"
          }
        }
      }
    },
    "root": {
      "type": "Column",
      "id": "list",
      "children": [
        {
          "type": "$repeat",
          "id": "each",
          "items": {
            "$expr": "state.rows"
          },
          "as": "row",
          "key": {
            "$expr": "row.id"
          },
          "children": [
            {
              "type": "Text",
              "id": "name",
              "properties": {
                "text": {
                  "$expr": "$concat($str(row_index), ':', row.name)"
                }
              }
            }
          ]
        }
      ]
    }
  },
  "state": {
    "rows": [
      {
        "id": "alpha",
        "name": "Alpha",
        "url": "https://example.com/a"
      },
      {
        "id": "beta",
        "name": "Beta",
        "url": "https://example.com/b"
      }
    ]
  },
  "expect": {
    "view": {
      "type": "Column",
      "reference": "list",
      "children": [
        {
          "type": "Text",
          "reference": "name[alpha]",
          "properties": {
            "text": "0:Alpha"
          }
        },
        {
          "type": "Text",
          "reference": "name[beta]",
          "properties": {
            "text": "1:Beta"
          }
        }
      ]
    },
    "occurrences": []
  }
}

{
  "name": "gate-lifecycle-action-handler-missing",
  "description": "A custom action bound to a lifecycle signal needs an action handler like any other",
  "document": {
    "version": "2.1.0",
    "state": {
      "count": "int"
    },
    "root": {
      "type": "Column",
      "id": "root",
      "children": [
        {
          "type": "Text",
          "id": "t",
          "properties": {
            "text": {
              "$expr": "$str(state.count)"
            }
          }
        }
      ]
    },
    "on": {
      "appear": [
        {
          "action": "track"
        }
      ]
    }
  },
  "state": {
    "count": 0
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "action-handler",
      "expected": "action handler"
    }
  },
  "config": {
    "actionHandler": false,
    "actions": {
      "declare": {
        "track": {}
      }
    }
  }
}

{
  "name": "gate-repeat-key-expression-error",
  "description": "A key that does not type-check is the expression violation, anchored to the construct",
  "document": {
    "version": "2.1.0",
    "state": {
      "rows": {
        "array": {
          "record": {
            "id": "string",
            "name": "string",
            "url": "string"
          }
        }
      }
    },
    "root": {
      "type": "Column",
      "id": "list",
      "children": [
        {
          "type": "$repeat",
          "id": "each",
          "items": {
            "$expr": "state.rows"
          },
          "as": "row",
          "key": {
            "$expr": "row.nope"
          },
          "children": [
            {
              "type": "Text",
              "id": "name",
              "properties": {
                "text": {
                  "$expr": "row.name"
                }
              }
            }
          ]
        }
      ]
    }
  },
  "state": {
    "rows": [
      {
        "id": "alpha",
        "name": "Alpha",
        "url": "https://example.com/a"
      },
      {
        "id": "beta",
        "name": "Beta",
        "url": "https://example.com/b"
      }
    ]
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "expression",
      "node": "each",
      "expected": "string or int"
    }
  }
}

{
  "name": "gate-array-update-undeclared-field",
  "description": "The field must be one the element record declares",
  "document": {
    "version": "2.1.0",
    "state": {
      "rows": {
        "array": {
          "record": {
            "name": "string",
            "done": "bool"
          }
        }
      },
      "n": "int"
    },
    "root": {
      "type": "Column",
      "id": "c",
      "children": [
        {
          "type": "Button",
          "id": "toggle",
          "properties": {
            "label": "Toggle",
            "enabled": true
          },
          "on": {
            "tap": [
              {
                "action": "$update",
                "key": "rows",
                "at": 0,
                "field": "size",
                "value": 1
              }
            ]
          }
        },
        {
          "type": "$repeat",
          "id": "list",
          "items": {
            "$expr": "state.rows"
          },
          "as": "row",
          "children": [
            {
              "type": "Text",
              "id": "row_text",
              "properties": {
                "text": {
                  "$expr": "$concat(row.name, $if(row.done, ' done', ''))"
                }
              }
            }
          ]
        }
      ]
    }
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "action-encoding",
      "node": "toggle",
      "expected": "declared field",
      "found": "size"
    }
  }
}

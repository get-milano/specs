{
  "name": "watch-from-lifecycle-binding",
  "description": "A mutation from a lifecycle list triggers the watch",
  "document": {
    "version": "2.1.0",
    "state": {
      "a": "int",
      "b": "int",
      "c": "int"
    },
    "root": {
      "type": "Column",
      "id": "c",
      "children": [
        {
          "type": "Text",
          "id": "a",
          "properties": {
            "text": {
              "$expr": "$str(state.a)"
            }
          }
        },
        {
          "type": "Text",
          "id": "b",
          "properties": {
            "text": {
              "$expr": "$str(state.b)"
            }
          }
        },
        {
          "type": "Button",
          "id": "go",
          "properties": {
            "label": "Go",
            "enabled": true
          },
          "on": {
            "tap": []
          }
        }
      ]
    },
    "watch": {
      "a": [
        {
          "action": "$set",
          "key": "b",
          "value": {
            "$expr": "state.a * 2"
          }
        }
      ]
    },
    "on": {
      "appear": [
        {
          "action": "$set",
          "key": "a",
          "value": 1
        }
      ]
    }
  },
  "state": {
    "a": 0,
    "b": 0,
    "c": 0
  },
  "steps": [
    {
      "appear": true
    }
  ],
  "expect": {
    "state": {
      "a": 1,
      "b": 2,
      "c": 0
    },
    "occurrences": [],
    "interactions": [
      {
        "kind": "viewBuilt"
      },
      {
        "kind": "viewAppeared"
      }
    ]
  }
}

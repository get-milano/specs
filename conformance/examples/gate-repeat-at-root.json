{
  "name": "gate-repeat-at-root",
  "description": "A $repeat is never the root: instances need a parent to take the construct's place in",
  "document": {
    "version": "2.0.0",
    "state": {
      "rows": {
        "array": {
          "record": {
            "name": "string",
            "url": "string"
          }
        }
      }
    },
    "root": {
      "type": "$repeat",
      "id": "each",
      "items": {
        "$expr": "state.rows"
      },
      "as": "row",
      "children": [
        {
          "type": "Text",
          "id": "name",
          "properties": {
            "text": {
              "$expr": "row.name"
            }
          }
        }
      ]
    }
  },
  "state": {
    "rows": [
      {
        "name": "Alpha",
        "url": "https://example.com/a"
      },
      {
        "name": "Beta",
        "url": "https://example.com/b"
      }
    ]
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "repeat",
      "node": "each",
      "expected": "child position",
      "found": "root"
    }
  }
}

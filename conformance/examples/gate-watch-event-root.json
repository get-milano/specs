{
  "name": "gate-watch-event-root",
  "description": "Watch lists carry no payload: the event root is unavailable",
  "document": {
    "version": "2.1.0",
    "state": {
      "a": "int",
      "b": "int",
      "c": "int"
    },
    "root": {
      "type": "Column",
      "id": "c",
      "children": [
        {
          "type": "Text",
          "id": "a",
          "properties": {
            "text": {
              "$expr": "$str(state.a)"
            }
          }
        },
        {
          "type": "Text",
          "id": "b",
          "properties": {
            "text": {
              "$expr": "$str(state.b)"
            }
          }
        },
        {
          "type": "Button",
          "id": "go",
          "properties": {
            "label": "Go",
            "enabled": true
          },
          "on": {
            "tap": []
          }
        }
      ]
    },
    "watch": {
      "a": [
        {
          "action": "$set",
          "key": "b",
          "value": {
            "$expr": "event"
          }
        }
      ]
    }
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "expression",
      "expected": "int"
    }
  }
}

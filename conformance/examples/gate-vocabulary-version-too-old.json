{
  "name": "gate-vocabulary-version-too-old",
  "description": "A document requiring a newer vocabulary version fails with SchemaViolation",
  "document": {
    "version": "2.0.0",
    "vocabulary": {
      "name": "examples",
      "min": "9.9.9"
    },
    "root": {
      "type": "Text",
      "id": "t",
      "properties": {
        "text": "hi"
      }
    }
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "vocabulary-requirement",
      "expected": ">=9.9.9",
      "found": "1.1.0"
    }
  }
}

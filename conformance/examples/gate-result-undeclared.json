{
  "name": "gate-result-undeclared",
  "description": "result is unavailable inside onSuccess of an action declaring no result",
  "document": {
    "version": "1.0.0",
    "state": {
      "label": "string"
    },
    "root": {
      "type": "Button",
      "id": "b",
      "properties": {
        "label": "Go",
        "enabled": true
      },
      "on": {
        "tap": [
          {
            "action": "ping",
            "onSuccess": [
              {
                "action": "$set",
                "key": "label",
                "value": {
                  "$expr": "result"
                }
              }
            ]
          }
        ]
      }
    }
  },
  "state": {
    "label": ""
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "expression",
      "node": "b"
    }
  },
  "config": {
    "actions": {
      "declare": {
        "ping": {}
      }
    }
  }
}

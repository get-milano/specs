{
  "name": "completion-failure-optional-absent",
  "description": "A failure completion without a value satisfies an optional failure declaration: failure is null and onFailure runs",
  "document": {
    "version": "2.1.0",
    "state": {
      "message": "string"
    },
    "root": {
      "type": "Button",
      "id": "b",
      "properties": {
        "label": "Go",
        "enabled": true
      },
      "on": {
        "tap": [
          {
            "action": "fetchCode",
            "onFailure": [
              {
                "action": "$set",
                "key": "message",
                "value": {
                  "$expr": "failure ?? 'unknown'"
                }
              }
            ]
          }
        ]
      }
    }
  },
  "state": {
    "message": "start"
  },
  "steps": [
    {
      "event": {
        "node": "b",
        "name": "tap"
      }
    },
    {
      "complete": {
        "dispatch": 0,
        "outcome": "failure"
      }
    }
  ],
  "expect": {
    "state": {
      "message": "unknown"
    },
    "dispatched": [
      {
        "action": "fetchCode",
        "parameters": {},
        "dispatch": 0
      }
    ],
    "occurrences": []
  },
  "config": {
    "actions": {
      "declare": {
        "fetchCode": {
          "failure": "string?"
        }
      }
    }
  }
}

{
  "name": "gate-array-append-undeclared-key",
  "description": "An array action targeting a key the document does not declare is the action-encoding violation every $set target shares",
  "document": {
    "version": "2.1.0",
    "state": {
      "items": {
        "array": "string"
      },
      "n": "int"
    },
    "root": {
      "type": "Column",
      "id": "c",
      "children": [
        {
          "type": "Text",
          "id": "count",
          "properties": {
            "text": {
              "$expr": "$str($length(state.items))"
            }
          }
        },
        {
          "type": "Button",
          "id": "add",
          "properties": {
            "label": "Add",
            "enabled": true
          },
          "on": {
            "tap": [
              {
                "action": "$append",
                "key": "nope",
                "value": "x"
              }
            ]
          }
        }
      ]
    }
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "action-encoding",
      "node": "add",
      "expected": "declared state key",
      "found": "nope"
    }
  }
}

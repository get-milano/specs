{
  "name": "gen-order-event-binding-then-action-encoding",
  "description": "Generated (order): event-binding on node a, then action-encoding on node b; the first defect in document order wins",
  "document": {
    "version": "1.0.0",
    "root": {
      "type": "Column",
      "id": "root",
      "children": [
        {
          "type": "Button",
          "id": "a",
          "properties": {
            "label": "A",
            "enabled": true
          },
          "on": {
            "nope": []
          }
        },
        {
          "type": "Button",
          "id": "b",
          "properties": {
            "label": "B",
            "enabled": true
          },
          "on": {
            "tap": [
              {
                "action": "$set",
                "key": "undeclared",
                "value": 1
              }
            ]
          }
        }
      ]
    }
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "event-binding",
      "node": "a",
      "expected": "declared event",
      "found": "nope"
    }
  }
}

{
  "name": "gen-order-children-then-expression",
  "description": "Generated (order): children on node a, then expression on node b; the first defect in document order wins",
  "document": {
    "version": "1.0.0",
    "root": {
      "type": "Column",
      "id": "root",
      "children": [
        {
          "type": "Button",
          "id": "a",
          "properties": {
            "label": "A",
            "enabled": true
          },
          "children": [
            {
              "type": "Text",
              "id": "a-child",
              "properties": {
                "text": "x"
              }
            }
          ]
        },
        {
          "type": "Button",
          "id": "b",
          "properties": {
            "label": {
              "$expr": "state.nope"
            },
            "enabled": true
          }
        }
      ]
    }
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "children",
      "node": "a",
      "expected": "no children",
      "found": "children"
    }
  }
}

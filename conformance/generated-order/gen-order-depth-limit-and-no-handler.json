{
  "name": "gen-order-depth-limit-and-no-handler",
  "description": "Generated (order): depth-limit beside no-handler on node a; the gate's order decides which error wins",
  "config": {
    "limits": {
      "maxTreeDepth": 1
    },
    "actionHandler": false
  },
  "document": {
    "version": "1.0.0",
    "root": {
      "type": "Column",
      "id": "root",
      "children": [
        {
          "type": "Button",
          "id": "a",
          "properties": {
            "label": "A",
            "enabled": true
          },
          "on": {
            "tap": [
              {
                "action": "openUrl",
                "url": "https://example.com"
              }
            ]
          }
        },
        {
          "type": "Button",
          "id": "b",
          "properties": {
            "label": "B",
            "enabled": true
          }
        }
      ]
    }
  },
  "expect": {
    "error": {
      "type": "LimitExceeded",
      "limit": "maxTreeDepth",
      "value": 1,
      "actual": 2
    }
  }
}

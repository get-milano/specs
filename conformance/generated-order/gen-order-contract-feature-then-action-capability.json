{
  "name": "gen-order-contract-feature-then-action-capability",
  "description": "Generated (order): contract-feature on node a, then action-capability on node b; the first defect in document order wins",
  "document": {
    "version": "1.0.0",
    "root": {
      "type": "Column",
      "id": "root",
      "children": [
        {
          "type": "Button",
          "id": "a",
          "properties": {
            "label": {
              "$expr": "$str($abs(1))"
            },
            "enabled": true
          }
        },
        {
          "type": "Button",
          "id": "b",
          "properties": {
            "label": "B",
            "enabled": true
          },
          "on": {
            "tap": [
              {
                "action": "secret"
              }
            ]
          }
        }
      ]
    }
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "contract-feature",
      "node": "a",
      "expected": "2.1",
      "found": "$abs"
    }
  }
}

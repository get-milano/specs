{
  "name": "gen-order-value-size-and-children",
  "description": "Generated (order): value-size beside children on node a; the gate's order decides which error wins",
  "config": {
    "limits": {
      "maxValueSize": 4
    }
  },
  "document": {
    "version": "1.0.0",
    "root": {
      "type": "Column",
      "id": "root",
      "children": [
        {
          "type": "Button",
          "id": "a",
          "properties": {
            "label": "A",
            "enabled": true
          },
          "children": [
            {
              "type": "Text",
              "id": "a-child",
              "properties": {
                "text": "x"
              }
            }
          ]
        },
        {
          "type": "Button",
          "id": "b",
          "properties": {
            "label": "B",
            "enabled": true
          }
        }
      ]
    },
    "context": {
      "big": "string"
    }
  },
  "context": {
    "big": "0123456789"
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "children",
      "node": "a",
      "expected": "no children",
      "found": "children"
    }
  }
}

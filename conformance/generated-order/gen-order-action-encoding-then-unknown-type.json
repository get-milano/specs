{
  "name": "gen-order-action-encoding-then-unknown-type",
  "description": "Generated (order): action-encoding on node a, then unknown-type on node b; the first defect in document order wins",
  "document": {
    "version": "1.0.0",
    "root": {
      "type": "Column",
      "id": "root",
      "children": [
        {
          "type": "Button",
          "id": "a",
          "properties": {
            "label": "A",
            "enabled": true
          },
          "on": {
            "tap": [
              {
                "action": "$set",
                "key": "undeclared",
                "value": 1
              }
            ]
          }
        },
        {
          "type": "Mystery",
          "id": "b",
          "properties": {
            "label": "B",
            "enabled": true
          }
        }
      ]
    }
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "action-encoding",
      "node": "a",
      "expected": "declared state key"
    }
  }
}

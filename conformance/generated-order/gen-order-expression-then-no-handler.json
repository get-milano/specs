{
  "name": "gen-order-expression-then-no-handler",
  "description": "Generated (order): expression on node a, then no-handler on node b; the first defect in document order wins",
  "config": {
    "actionHandler": false
  },
  "document": {
    "version": "1.0.0",
    "root": {
      "type": "Column",
      "id": "root",
      "children": [
        {
          "type": "Button",
          "id": "a",
          "properties": {
            "label": {
              "$expr": "state.nope"
            },
            "enabled": true
          }
        },
        {
          "type": "Button",
          "id": "b",
          "properties": {
            "label": "B",
            "enabled": true
          },
          "on": {
            "tap": [
              {
                "action": "openUrl",
                "url": "https://example.com"
              }
            ]
          }
        }
      ]
    }
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "expression",
      "node": "a",
      "expected": "string"
    }
  }
}

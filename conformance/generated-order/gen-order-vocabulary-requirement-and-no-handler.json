{
  "name": "gen-order-vocabulary-requirement-and-no-handler",
  "description": "Generated (order): vocabulary-requirement beside no-handler on node a; the gate's order decides which error wins",
  "config": {
    "actionHandler": false
  },
  "document": {
    "version": "1.0.0",
    "root": {
      "type": "Column",
      "id": "root",
      "children": [
        {
          "type": "Button",
          "id": "a",
          "properties": {
            "label": "A",
            "enabled": true
          },
          "on": {
            "tap": [
              {
                "action": "openUrl",
                "url": "https://example.com"
              }
            ]
          }
        },
        {
          "type": "Button",
          "id": "b",
          "properties": {
            "label": "B",
            "enabled": true
          }
        }
      ]
    },
    "vocabulary": {
      "name": "other"
    }
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "vocabulary-requirement",
      "expected": "other",
      "found": "generated_order"
    }
  }
}

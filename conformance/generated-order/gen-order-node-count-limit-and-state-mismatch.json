{
  "name": "gen-order-node-count-limit-and-state-mismatch",
  "description": "Generated (order): node-count-limit and state-mismatch in one document; the gate's order decides which error wins",
  "config": {
    "limits": {
      "maxNodeCount": 2
    }
  },
  "document": {
    "version": "1.0.0",
    "root": {
      "type": "Column",
      "id": "root",
      "children": [
        {
          "type": "Button",
          "id": "a",
          "properties": {
            "label": "A",
            "enabled": true
          }
        },
        {
          "type": "Button",
          "id": "b",
          "properties": {
            "label": "B",
            "enabled": true
          }
        }
      ]
    },
    "state": {
      "n": "int"
    }
  },
  "state": {
    "n": "x"
  },
  "expect": {
    "error": {
      "type": "LimitExceeded",
      "limit": "maxNodeCount",
      "value": 2,
      "actual": 3
    }
  }
}

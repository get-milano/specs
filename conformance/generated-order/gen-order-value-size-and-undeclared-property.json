{
  "name": "gen-order-value-size-and-undeclared-property",
  "description": "Generated (order): value-size beside undeclared-property on node a; the gate's order decides which error wins",
  "config": {
    "limits": {
      "maxValueSize": 4
    }
  },
  "document": {
    "version": "1.0.0",
    "root": {
      "type": "Column",
      "id": "root",
      "children": [
        {
          "type": "Meta",
          "id": "a",
          "properties": {
            "key": "k",
            "extra": 1
          }
        },
        {
          "type": "Button",
          "id": "b",
          "properties": {
            "label": "B",
            "enabled": true
          }
        }
      ]
    },
    "context": {
      "big": "string"
    }
  },
  "context": {
    "big": "0123456789"
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "undeclared-property",
      "node": "a",
      "found": "extra"
    }
  }
}

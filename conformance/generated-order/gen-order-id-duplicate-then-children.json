{
  "name": "gen-order-id-duplicate-then-children",
  "description": "Generated (order): id-duplicate on node a, then children on node b; the first defect in document order wins",
  "document": {
    "version": "1.0.0",
    "root": {
      "type": "Column",
      "id": "root",
      "children": [
        {
          "type": "Button",
          "id": "root",
          "properties": {
            "label": "A",
            "enabled": true
          }
        },
        {
          "type": "Button",
          "id": "b",
          "properties": {
            "label": "B",
            "enabled": true
          },
          "children": [
            {
              "type": "Text",
              "id": "b-child",
              "properties": {
                "text": "x"
              }
            }
          ]
        }
      ]
    }
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",

{
  "name": "gen-order-no-handler-then-undeclared-property",
  "description": "Generated (order): no-handler on node a, then undeclared-property on node b; the first defect in document order wins",
  "config": {
    "actionHandler": false
  },
  "document": {
    "version": "1.0.0",
    "root": {
      "type": "Column",
      "id": "root",
      "children": [
        {
          "type": "Button",
          "id": "a",
          "properties": {
            "label": "A",
            "enabled": true
          },
          "on": {
            "tap": [
              {
                "action": "openUrl",
                "url": "https://example.com"
              }
            ]
          }
        },
        {
          "type": "Meta",
          "id": "b",
          "properties": {
            "key": "k",
            "extra": 1
          }
        }
      ]
    }
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "undeclared-property",
      "node": "b"
    }
  }
}

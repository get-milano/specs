{
  "name": "gen-order-value-size-and-no-handler",
  "description": "Generated (order): value-size beside no-handler on node a; the gate's order decides which error wins",
  "config": {
    "limits": {
      "maxValueSize": 4
    },
    "actionHandler": false
  },
  "document": {
    "version": "1.0.0",
    "root": {
      "type": "Column",
      "id": "root",
      "children": [
        {
          "type": "Button",
          "id": "a",
          "properties": {
            "label": "A",
            "enabled": true
          },
          "on": {
            "tap": [
              {
                "action": "openUrl",
                "url": "https://example.com"
              }
            ]
          }
        },
        {
          "type": "Button",
          "id": "b",
          "properties": {
            "label": "B",
            "enabled": true
          }
        }
      ]
    },
    "context": {
      "big": "string"
    }
  },
  "context": {
    "big": "0123456789"
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "action-handler",
      "expected": "action handler"
    }
  }
}

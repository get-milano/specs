{
  "name": "gen-order-no-handler-then-children",
  "description": "Generated (order): no-handler on node a, then children on node b; the first defect in document order wins",
  "config": {
    "actionHandler": false
  },
  "document": {
    "version": "1.0.0",
    "root": {
      "type": "Column",
      "id": "root",
      "children": [
        {
          "type": "Button",
          "id": "a",
          "properties": {
            "label": "A",
            "enabled": true
          },
          "on": {
            "tap": [
              {
                "action": "openUrl",
                "url": "https://example.com"
              }
            ]
          }
        },
        {
          "type": "Button",
          "id": "b",
          "properties": {
            "label": "B",
            "enabled": true
          },
          "children": [
            {
              "type": "Text",
              "id": "b-child",
              "properties": {
                "text": "x"
              }
            }
          ]
        }
      ]
    }
  },
  "expect": {
    "error": {
      "type": "SchemaViolation",
      "rule": "children",
      "node": "b",
      "expected": "no children"
    }
  }
}

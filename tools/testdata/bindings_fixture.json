{
  "milano": "1.0.0",
  "name": "fixture",
  "version": "2.3.4",
  "components": {
    "Widget": {
      "properties": {
        "title": "string",
        "subtitle": "string?",
        "count": "int",
        "ratio": "double?",
        "enabled": "bool",
        "tags": {
          "array": "string"
        },
        "layout": {
          "enum": [
            "wide",
            "compact"
          ]
        },
        "tone": {
          "enum": [
            "light",
            "dark"
          ],
          "optional": true
        },
        "payload": {
          "record": {
            "id": "string",
            "count": "int?",
            "kind": {
              "enum": [
                "minor",
                "major"
              ]
            },
            "owner": {
              "record": {
                "name": "string"
              }
            },
            "labels": {
              "array": "string",
              "optional": true
            }
          }
        },
        "items": {
          "array": {
            "record": {
              "sku": "string",
              "qty": "int"
            }
          }
        }
      },
      "events": {
        "tap": null,
        "change": "string",
        "resize": "int?",
        "pick": {
          "enum": [
            "one",
            "two"
          ]
        },
        "submit": {
          "record": {
            "id": "string",
            "lines": {
              "array": "int"
            }
          }
        }
      },
      "children": true
    },
    "Plain": {}
  },
  "actions": {
    "noop": {},
    "openUrl": {
      "parameters": {
        "url": "string",
        "referrer": "string?"
      }
    },
    "submit": {
      "parameters": {
        "mode": {
          "enum": [
            "final",
            "draft"
          ]
        }
      },
      "result": "string"
    },
    "order": {
      "parameters": {
        "cart": {
          "record": {
            "id": "string",
            "lines": {
              "array": "int"
            }
          }
        },
        "note": {
          "record": {
            "text": "string"
          },
          "optional": true
        }
      },
      "result": {
        "record": {
          "reference": "string"
        }
      }
    }
  }
}

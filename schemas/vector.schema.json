{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vector.schema.json",
  "title": "Milano Conformance Vector",
  "description": "Validates a conformance vector's envelope per the conformance suite spec: identity, exactly one document form, optional data and interaction steps, and the expectation block. A structurally invalid document must be carried as documentText, so every embedded document object satisfies the document schema. The envelope is strict: unknown keys fail, since runners would silently ignore them.",
  "type": "object",
  "required": [
    "name",
    "expect"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "document": {
      "$ref": "document.schema.json"
    },
    "documentText": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      }
    },
    "context": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "unknownTypePolicy": {
          "enum": [
            "skip",
            "placeholder",
            "fail"
          ]
        },
        "actions": {
          "type": "object",
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identifier"
              }
            },
            "declare": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/identifier"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "parameters": {
                    "type": "object",
                    "propertyNames": {
                      "$ref": "#/$defs/identifier"
                    },
                    "additionalProperties": {
                      "$ref": "document.schema.json#/$defs/type"
                    }
                  },
                  "result": {
                    "$ref": "document.schema.json#/$defs/type"
                  },
                  "failure": {
                    "$ref": "document.schema.json#/$defs/type"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxTreeDepth": {
              "type": "integer",
              "minimum": 1
            },
            "maxNodeCount": {
              "type": "integer",
              "minimum": 1
            },
            "maxDocumentBytes": {
              "type": "integer",
              "minimum": 1
            },
            "maxExpressionLength": {
              "type": "integer",
              "minimum": 1
            },
            "maxValueSize": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "stateDataProvider": {
          "type": "boolean"
        },
        "actionHandler": {
          "type": "boolean"
        },
        "functionHandler": {
          "type": "boolean"
        },
        "functions": {
          "type": "object",
          "properties": {
            "declare": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/identifier"
              },
              "additionalProperties": {
                "type": "object",
                "required": [
                  "arguments",
                  "returns"
                ],
                "properties": {
                  "arguments": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "document.schema.json#/$defs/type"
                    }
                  },
                  "returns": {
                    "$ref": "document.schema.json#/$defs/type"
                  }
                },
                "additionalProperties": false
              }
            },
            "results": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/identifier"
              },
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "arguments"
                  ],
                  "properties": {
                    "arguments": {
                      "type": "array"
                    },
                    "returns": {},
                    "throws": {
                      "const": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "expect": {
      "$ref": "#/$defs/expect"
    }
  },
  "oneOf": [
    {
      "required": [
        "document"
      ],
      "not": {
        "required": [
          "documentText"
        ]
      }
    },
    {
      "required": [
        "documentText"
      ],
      "not": {
        "required": [
          "document"
        ]
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "step": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "event": {
          "type": "object",
          "required": [
            "node",
            "name"
          ],
          "properties": {
            "node": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "$ref": "#/$defs/identifier"
            },
            "payload": {}
          },
          "additionalProperties": false
        },
        "contextUpdate": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          }
        },
        "appear": {
          "const": true
        },
        "disappear": {
          "const": true
        },
        "teardown": {
          "const": true
        },
        "complete": {
          "type": "object",
          "required": [
            "dispatch",
            "outcome"
          ],
          "properties": {
            "dispatch": {
              "type": "integer",
              "minimum": 0
            },
            "outcome": {
              "enum": [
                "success",
                "failure"
              ]
            },
            "payload": {}
          },
          "additionalProperties": false
        },
        "replace": {
          "type": "object",
          "properties": {
            "document": {
              "$ref": "document.schema.json"
            },
            "documentText": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/identifier"
              }
            },
            "error": {
              "$ref": "#/$defs/error"
            }
          },
          "oneOf": [
            {
              "required": [
                "document"
              ],
              "not": {
                "required": [
                  "documentText"
                ]
              }
            },
            {
              "required": [
                "documentText"
              ],
              "not": {
                "required": [
                  "document"
                ]
              }
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "expect": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "view": {
          "$ref": "#/$defs/resolvedNode"
        },
        "state": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          }
        },
        "dispatched": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "$ref": "#/$defs/identifier"
              },
              "parameters": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/identifier"
                }
              },
              "dispatch": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "occurrences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "unknownTypeSkipped",
                  "unknownTypePlaceholder",
                  "undeclaredProperty",
                  "droppedEvent",
                  "invalidEmission",
                  "invalidCompletion",
                  "duplicateCompletion",
                  "completionAfterTeardown",
                  "completionAfterReplace",
                  "rejectedContextUpdate",
                  "rejectedMutation",
                  "divisionByZero",
                  "saturation",
                  "invalidFunctionResult"
                ]
              },
              "node": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "expected": {
                "type": "string",
                "minLength": 1
              },
              "found": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "interactions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "viewBuilt",
                  "viewReplaced",
                  "viewAppeared",
                  "viewDisappeared",
                  "viewTornDown",
                  "event",
                  "actionDispatched",
                  "completionSucceeded",
                  "completionFailed",
                  "tap",
                  "doubleTap",
                  "longPress",
                  "focusGained",
                  "focusLost",
                  "textChanged",
                  "toggled",
                  "selectionChanged",
                  "valueChanged",
                  "appeared",
                  "disappeared",
                  "scrolled"
                ]
              },
              "node": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {},
              "dispatch": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "resolvedNode": {
      "type": "object",
      "required": [
        "type",
        "reference"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^\\$?[A-Za-z][A-Za-z0-9_]*$"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "placeholder": {
          "const": true
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resolvedNode"
          }
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "MalformedDocument",
            "UnsupportedVersion",
            "SchemaViolation",
            "UnknownComponentType",
            "LimitExceeded"
          ]
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document.schema.json",
  "title": "Milano Document",
  "description": "Validates the canonical JSON encoding of a Milano document per the document model spec: top-level structure, node envelope, lifecycle bindings, values and expressions, and action encoding. Every object the contract may grow (the top level, the node envelope, the vocabulary section, type descriptors) is open, matching the contract's tolerance rules; only the $expr wrapper is closed, since the model defines it as exactly single-key. Semantic rules (vocabulary resolution, expression typing, id uniqueness, resource limits) belong to the gate, not this schema.",
  "type": "object",
  "required": [
    "version",
    "root"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "vocabulary": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "min": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "context": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/type"
      }
    },
    "state": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/type"
      }
    },
    "root": {
      "$ref": "#/$defs/node"
    },
    "on": {
      "description": "Lifecycle bindings (contract 2.1): action lists bound to the appear and disappear signals.",
      "type": "object",
      "propertyNames": {
        "enum": [
          "appear",
          "disappear"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/actionOrList"
      }
    },
    "metadata": {
      "type": "object"
    },
    "watch": {
      "description": "Watch bindings (contract 2.2): action lists bound to changes of declared state keys.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/actionOrList"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "node": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^\\$?[A-Za-z][A-Za-z0-9_]*$"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "items": {
          "description": "$repeat only: the array expression the template is instantiated over.",
          "$ref": "#/$defs/value"
        },
        "as": {
          "description": "$repeat only: the name that binds each element inside the template; <as>_index binds its position.",
          "type": "string",
          "minLength": 1
        },
        "key": {
          "description": "$repeat only (contract 2.1): an expression identifying each instance; its rendering replaces the element index in the instance's reference.",
          "$ref": "#/$defs/expression"
        },
        "on": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/actionOrList"
          }
        },
        "condition": {
          "description": "$if only (contract 2.1): the bool expression choosing the branch.",
          "$ref": "#/$defs/value"
        },
        "then": {
          "description": "$if only (contract 2.1): the nodes materialized when the condition holds.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "else": {
          "description": "$if only (contract 2.1): the nodes materialized when it does not; absent materializes nothing.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "subject": {
          "description": "$switch only (contract 2.1): the enum expression choosing the branch.",
          "$ref": "#/$defs/value"
        },
        "cases": {
          "description": "$switch only (contract 2.1): the nodes each enum member materializes.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/node"
            }
          }
        },
        "default": {
          "description": "$switch only (contract 2.1): the nodes every member without a case materializes.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "value": {
      "description": "A literal of the declared type, or an expression wrapper. An object carrying $expr must be exactly the single-key wrapper.",
      "anyOf": [
        {
          "$ref": "#/$defs/expression"
        },
        {
          "not": {
            "type": "object",
            "required": [
              "$expr"
            ]
          }
        }
      ]
    },
    "expression": {
      "type": "object",
      "required": [
        "$expr"
      ],
      "properties": {
        "$expr": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "actionOrList": {
      "anyOf": [
        {
          "$ref": "#/$defs/action"
        },
        {
          "$ref": "#/$defs/actionList"
        }
      ]
    },
    "actionList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "action": {
      "type": "object",
      "required": [
        "action"
      ],
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "properties": {
        "action": {
          "type": "string",
          "pattern": "^(\\$set|\\$append|\\$remove|\\$update|\\$sequence|\\$when|[A-Za-z][A-Za-z0-9_]*)$"
        },
        "onSuccess": {
          "$ref": "#/$defs/actionOrList"
        },
        "onFailure": {
          "$ref": "#/$defs/actionOrList"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/value"
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "$set"
              }
            }
          },
          "then": {
            "required": [
              "key",
              "value"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "$append"
              }
            }
          },
          "then": {
            "required": [
              "key",
              "value"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "$remove"
              }
            }
          },
          "then": {
            "required": [
              "key",
              "at"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "$update"
              }
            }
          },
          "then": {
            "required": [
              "key",
              "at",
              "field",
              "value"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/identifier"
              },
              "field": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "$sequence"
              }
            }
          },
          "then": {
            "required": [
              "actions"
            ],
            "properties": {
              "actions": {
                "$ref": "#/$defs/actionList"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "$when"
              }
            }
          },
          "then": {
            "required": [
              "condition"
            ],
            "properties": {
              "then": {
                "$ref": "#/$defs/actionList"
              },
              "else": {
                "$ref": "#/$defs/actionList"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "pattern": "^\\$"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "onSuccess"
                  ]
                },
                {
                  "required": [
                    "onFailure"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "type": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(bool|int|double|string)\\??$"
        },
        {
          "type": "object",
          "required": [
            "enum"
          ],
          "properties": {
            "enum": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            },
            "optional": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "array"
          ],
          "properties": {
            "array": {
              "$ref": "#/$defs/type"
            },
            "optional": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "record"
          ],
          "properties": {
            "record": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/identifier"
              },
              "additionalProperties": {
                "$ref": "#/$defs/type"
              }
            },
            "optional": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  }
}
